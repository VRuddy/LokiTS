      "name": "LokiDB",
      "packageName": "@lokidb/loki",
      "notes": "Default options. Unique indexes on id and email (lookups with by()), ranged index on age, DynamicView for the live query. Unmaintained since 2022."
    },
    {
      "name": "TinyBase",
      "packageName": "tinybase",
      "notes": "Store with indexes on email and age (range = union of age slices). Ad hoc queries are defined, read and deleted per call so they are not maintained afterwards; top scores use getSortedRowIds. One transaction per bulk insert."
    },
    {
      "name": "RxDB",
      "packageName": "rxdb",
      "notes": "Memory storage, no dev-mode, no schema validator (the fastest setup). Indexes on email and age; string primary key (ids converted on insert). Live query through the query observable. Identical queries are answered from the RxDB query cache while the data does not change."
    },
    {
      "name": "SQLite",
      "packageName": "node:sqlite",
      "notes": "node:sqlite, in-memory database, cached prepared statements, SELECT * (full rows, tags kept as JSON text), one transaction per bulk insert. No live queries."
    },
    {
      "name": "LokiTS",
      "packageName": "@lokits/core",
      "storage": "fs",
      "durability": "atomic replace with fsync",
      "notes": "Same collection setup as in memory; Loki.open, then saveDatabase() per write."
    },
    {
      "name": "LokiTS",
      "packageName": "@lokits/core",
      "storage": "fs-structured",
      "durability": "one file per collection, atomic generations with fsync",
