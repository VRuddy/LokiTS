    },
    {
      "name": "lokijs",
      "packageName": "lokijs",
      "storage": "fs",
      "durability": "file overwritten in place, no fsync",
      "notes": "Default LokiFsAdapter, same collection setup as LokiTS."
    },
    {
      "name": "LokiDB",
      "packageName": "@lokidb/loki",
      "storage": "fs",
      "durability": "temporary file then rename, no fsync",
      "notes": "@lokidb/fs-storage, unique indexes on id and email. No age index: LokiDB 2.1.0 loses the comparator of a ranged index on reload (restore() reads a function from JSON), so it does less index work on writes than the others."
    },
    {
      "name": "TinyBase",
      "packageName": "tinybase",
